RewriteEngine On

# Compression for text assets
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser cache lifetimes
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Force every public URL variant to one canonical shape:
# https://kursatca.com/...
# no www, no http, no top-level .html, no directory index files.
RewriteRule ^index\.html$ https://kursatca.com/ [L,NE,R=301]
RewriteRule ^(.+)/index\.html$ https://kursatca.com/$1/ [L,NE,R=301]
RewriteRule ^egitim\.html$ https://kursatca.com/egitim [L,NE,R=301]
RewriteRule ^yapay-zeka\.html$ https://kursatca.com/yapay-zeka [L,NE,R=301]
RewriteRule ^blog\.html$ https://kursatca.com/blog [L,NE,R=301]
RewriteRule ^hakkimda\.html$ https://kursatca.com/hakkimda [L,NE,R=301]

# Redirect old kuresel-baglantilar-atolyesi to new location
RewriteRule ^egitim/kuresel-baglantilar-atolyesi\.html$ https://kursatca.com/egitim/kuresel-baglantilar/ [L,NE,R=301]

# Force canonical scheme and host for everything else.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kursatca.com%{REQUEST_URI} [L,NE,R=301]

# Keep top-level pages extensionless even when same-named folders exist.
RewriteRule ^(egitim|yapay-zeka|blog)/$ /$1 [L,NE,R=301]
RewriteRule ^(egitim|yapay-zeka|blog)$ $1.html [NC,L]

# Redirect direct .html requests to extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ https://kursatca.com/$1 [L,NE,R=301]

# Internally rewrite extensionless to .html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# Error Documents
ErrorDocument 404 /404.html
